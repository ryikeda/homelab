entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: ":443"

certificatesResolvers:
  cloudflare:
    acme:
      email: {{ traefik_acme_email }}
      storage: {{ traefik_data_dir }}/acme.json
      dnsChallenge:
        provider: cloudflare
        resolvers:
          - "1.1.1.1:53"
          - "8.8.8.8:53"

api:
  dashboard: true

providers:
  file:
    directory: {{ traefik_dynamic_config_dir }}
    watch: true

log:
  level: INFO
