http:
  routers:
{% for site in traefik_install_reverse_proxy_sites %}
    {{ site.hostname | replace('.', '-') }}:
      rule: "Host(`{{ site.hostname }}`)"
      entryPoints:
        - websecure
      service: {{ site.hostname | replace('.', '-') }}
{% if site.basic_auth | default(false) %}
      middlewares:
        - dashboard-auth
{% endif %}
      tls:
        certResolver: cloudflare
{% endfor %}
    dashboard:
      rule: "Host(`traefik.{{ local_domain }}`)"
      entryPoints:
        - websecure
      service: api@internal
      middlewares:
        - dashboard-auth
      tls:
        certResolver: cloudflare

  middlewares:
    # Named for its original use (the Traefik dashboard itself), also
    # reused via `basic_auth: true` for any reverse_proxy_sites.yml entry
    # that needs to sit behind auth (e.g. CloudBeaver/SeaweedFS's filer UI -
    # full DB/bucket access, not something to leave open on the LAN alone).
    dashboard-auth:
      basicAuth:
        users:
          - "{{ traefik_dashboard_user }}:{{ traefik_dashboard_password_hash }}"

  services:
{% for site in traefik_install_reverse_proxy_sites %}
    {{ site.hostname | replace('.', '-') }}:
      loadBalancer:
        servers:
          - url: "{{ site.upstream }}"
{% if site.insecure_skip_verify | default(false) %}
        serversTransport: insecure-skip-verify
{% endif %}
{% endfor %}

{% if traefik_install_reverse_proxy_sites | selectattr('insecure_skip_verify', 'defined') | selectattr('insecure_skip_verify') | list | length > 0 %}
  serversTransports:
    insecure-skip-verify:
      insecureSkipVerify: true
{% endif %}
