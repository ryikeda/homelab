services:
  dockge:
    image: louislam/dockge:{{ dockge_version }}
    restart: unless-stopped
    ports:
      - "{{ dockge_port }}:5001"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - ./data:/app/data
      # Bind at the same path on both sides so Dockge can browse/manage
      # every stack under this directory, including its own.
      - {{ docker_stacks_dir }}:{{ docker_stacks_dir }}
    environment:
      - DOCKGE_STACKS_DIR={{ docker_stacks_dir }}
