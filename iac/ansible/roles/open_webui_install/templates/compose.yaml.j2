services:
  open-webui:
    image: ghcr.io/open-webui/open-webui:{{ open_webui_version }}
    restart: unless-stopped
    # Host networking, same as jellyfin/ollama - keeps the call to Ollama's
    # own host-networked API a plain localhost request, no cross-container
    # networking/host.docker.internal dance needed.
    network_mode: host
    environment:
      - OLLAMA_BASE_URL=http://localhost:{{ ollama_port }}
      - PORT={{ open_webui_port }}
    volumes:
      - ./data:/app/backend/data
