---
pve_host: 192.0.2.10
initial_password: change-me
admin_user_password_hash: "$6$replace-with-real-hash"

gpu_host: 192.0.2.54

palantir_host: 192.0.2.55
portainer_host: 192.0.2.56
grafana_install_admin_password: "REPLACE_ME"

# Tolkien theme (k3s cluster) - gondor is control-plane, rohan/shire workers.
gondor_host: 192.0.2.57
rohan_host: 192.0.2.58
shire_host: 192.0.2.59

rivendell_host: 192.0.2.61

postgres_install_password: "REPLACE_ME"
mongodb_install_password: "REPLACE_ME"
seaweedfs_install_s3_access_key: admin
seaweedfs_install_s3_secret_key: "REPLACE_ME"
cloudbeaver_install_admin_password: "REPLACE_ME"

opnsense_host: 192.0.2.12

opnsense_cameras_subnet: 192.0.2.0/24
opnsense_lan_dhcp_start: 192.0.2.100
opnsense_lan_dhcp_end: 192.0.2.200
opnsense_iot_dhcp_start: 192.0.2.100
opnsense_iot_dhcp_end: 192.0.2.200

# Pool MetalLB hands out as stable Service IPs - clear of DHCP and the
# static hosts above. See roles/metallb_install. Just one address for now
# - the in-cluster ingress controller is the only LoadBalancer-type
# Service (everything else routes through it via IngressRoute/HostRegexp).
# Widen this later (edit + re-apply metallb_install.yml, no reinstall
# needed) if something ever needs its own direct LoadBalancer IP.
metallb_install_ip_range: "192.0.2.60/32"

# The in-cluster Traefik ingress controller's MetalLB-assigned IP (see
# iac/argocd/apps/ingress-controller.yaml) - not knowable ahead of time,
# fill this in after the first deploy: `kubectl get svc -n
# ingress-controller`. Used by reverse_proxy_sites.yml as the upstream
# for all k8s-hosted hostnames.
k8s_ingress_lb_ip: "192.0.2.60"

technitium_host: 192.0.2.53
# API token itself lives in ~/.technitium/ansible.env, not here.

traefik_host: 192.0.2.52
traefik_acme_email: admin@example.com
traefik_dashboard_user: admin
# Password hash for the Traefik dashboard's basic auth, APR1-MD5 format -
# generate with: openssl passwd -apr1
traefik_dashboard_password_hash: "REPLACE_ME"
# Cloudflare API token itself lives in ~/.cloudflare/ansible.env, not here.

local_domain: local.example.com

nas_backup_server: 192.0.2.20
nas_backup_export: /volume1/pve-backups
